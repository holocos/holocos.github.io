---
// The Themelios emblem — a bronze theta (Θ, for θεμέλιος, "foundation") set in a
// rounded tile. Deliberately theme-independent: the tile stays dark and the
// bronze fixed in both light and dark mode, so the mark reads consistently
// wherever it appears. Decorative by default — the accompanying wordmark
// carries the accessible name.
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect
    x="1"
    y="1"
    width="62"
    height="62"
    rx="15"
    fill="#242426"
    stroke="#3A3A3C"
    stroke-width="1.5"></rect>
  <g fill="none" stroke="#C4A265" stroke-width="4.4" stroke-linecap="round">
    <ellipse cx="32" cy="32" rx="12.5" ry="15.5"></ellipse>
    <line x1="23.6" y1="32" x2="40.4" y2="32"></line>
  </g>
</svg>
