---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;

// Only surface h2/h3 for an "On this page" outline.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav aria-label="On this page" class="text-sm">
      <p class="mb-3 font-semibold uppercase tracking-wide text-text-muted text-xs">
        On this page
      </p>
      <ul class="space-y-2 border-l border-border">
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class:list={[
                'block border-l-2 border-transparent py-0.5 text-text-muted no-underline transition-colors hover:border-accent hover:text-text hover:no-underline',
                h.depth === 2 ? '-ml-px pl-4' : '-ml-px pl-8',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
