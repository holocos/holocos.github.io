---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'teachings'>;
}
const { entry } = Astro.props;
const { title, category, summary, keyScriptures, draft } = entry.data;
---

<a
  href={`/teachings/${entry.id}/`}
  class="group flex h-full flex-col rounded-2xl border border-border bg-bg-raised p-6 no-underline transition duration-200 hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-lg hover:no-underline focus-visible:-translate-y-0.5"
>
  <div class="flex flex-wrap items-center gap-2">
    <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-medium text-accent-strong">
      {category}
    </span>
    {
      draft && (
        <span class="rounded-full border border-border px-2 py-0.5 text-[10px] font-medium uppercase tracking-wide text-text-muted">
          Draft
        </span>
      )
    }
  </div>

  <h3 class="mt-3 font-serif text-xl font-semibold text-text transition-colors group-hover:text-accent">
    {title}
  </h3>

  <p class="mt-2 flex-1 text-[15px] leading-relaxed text-text-muted">
    {summary}
  </p>

  {
    keyScriptures.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {keyScriptures.map((s) => (
          <span class="rounded-md border border-border px-2 py-0.5 font-serif text-xs text-text-muted">
            {s}
          </span>
        ))}
      </div>
    )
  }
</a>
