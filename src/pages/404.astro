---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you were looking for could not be found."
  noIndex={true}
>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-28 text-center sm:px-6">
    <p class="font-serif text-6xl font-semibold text-accent">404</p>
    <h1 class="mt-4 text-3xl font-semibold sm:text-4xl">Page Not Found</h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-text-muted">
      The page you were looking for isn't here. It may have been moved, or the
      link may be incomplete.
    </p>

    <figure class="mt-10">
      <blockquote class="font-serif text-lg italic text-text">
        &ldquo;Thy word is a lamp unto my feet, and a light unto my path.&rdquo;
      </blockquote>
      <figcaption class="mt-2 text-sm font-medium text-accent">Psalm 119:105</figcaption>
    </figure>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-lg bg-accent px-6 py-3 text-base font-medium text-on-accent no-underline transition-opacity hover:opacity-90 hover:no-underline"
      >
        Return Home
      </a>
      <a
        href="/teachings/"
        class="inline-flex items-center justify-center rounded-lg border border-border px-6 py-3 text-base font-medium text-text no-underline transition-colors hover:bg-bg-subtle hover:no-underline"
      >
        Browse the Teachings
      </a>
    </div>
  </section>
</BaseLayout>
