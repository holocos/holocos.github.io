---
import { getCollection, render } from 'astro:content';
import DoctrineLayout from '../../layouts/DoctrineLayout.astro';
import Scripture from '../../components/Scripture.astro';
import SermonQuote from '../../components/SermonQuote.astro';
import Note from '../../components/Note.astro';

export async function getStaticPaths() {
  const teachings = await getCollection('teachings');
  // Order is the index position (plan §5). Sort once, then derive prev/next.
  const ordered = teachings.sort((a, b) => a.data.order - b.data.order);

  return ordered.map((entry, i) => {
    const prevEntry = ordered[i - 1];
    const nextEntry = ordered[i + 1];
    return {
      params: { slug: entry.id },
      props: {
        entry,
        prev: prevEntry
          ? { id: prevEntry.id, title: prevEntry.data.title }
          : undefined,
        next: nextEntry
          ? { id: nextEntry.id, title: nextEntry.data.title }
          : undefined,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);

// Custom components available to MDX bodies without an explicit import
// (plan §5). Markdown bodies simply ignore these until authored as .mdx.
const components = { Scripture, SermonQuote, Note };
---

<DoctrineLayout entry={entry} headings={headings} prev={prev} next={next}>
  <Content components={components} />
</DoctrineLayout>
